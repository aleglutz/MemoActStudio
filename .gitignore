__pycache__/
*.pyc

# Project media is never versioned — a single archival video is larger than the
# entire codebase. Scripts and generated tables stay in git; the assets they
# point at live on disk and travel by other means.
projects/*/images/
projects/*/video/
projects/*/sources/
projects/*/composites/
projects/*/narration.*
projects/*/out/
projects/*/generated/
projects/*/cloud_graphs/
projects/*/reel_p1.mp4

# Reference material and editor workspaces gathered per project. Not versioned
# for the same reason as the media: it is large, it is not source, and some of
# it arrives with names longer than Windows will index.
projects/*/refs/
projects/*/.freecut-workspace.json

# FreeCut plants an entire workspace wherever it is pointed — media copies,
# thumbnails, waveform caches, its own README and a nested projects/ tree.
# None of it is MemoActs source, and it churns on every edit.
projects/*/media/
projects/*/projects/
projects/*/index.json
projects/legends_of_surrender/README.md

# LibreOffice lock files, left behind while a .csv is open
.~lock.*#
