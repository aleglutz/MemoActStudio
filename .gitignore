__pycache__/
*.pyc

# Project media is never versioned — a single archival video is larger than the
# entire codebase. Scripts and generated tables stay in git; the assets they
# point at live on disk and travel by other means.
#
# Everything a shot can point at lives in <project>/sources/ — images, videos,
# composites, map plates — and so does the prose that says where it came from.
# The rules therefore ignore the *contents* of sources/ rather than the folder:
# a rule on the folder itself would put SOURCES.md and hook_page.md beyond the
# reach of any negation, and those are source in the sense that matters.
projects/*/sources/**
!projects/*/sources/**/
!projects/*/sources/**/*.md

# Superseded takes and the Audacity project they came out of. The rules above
# stop at sources/, and a 60 MB .aup3 sat in archive/ one `git add .` from the
# history. Prose in archive/ stays versioned — that is what the folder is for.
projects/*/archive/**
!projects/*/archive/**/
!projects/*/archive/**/*.md
!projects/*/archive/**/*.json

# The recording, the compiler's own output, and the finished reel.
projects/*/narration.*
projects/*/voiceover.*
projects/*/out/
projects/*/generated/
projects/*/cloud_graphs/
projects/*/reel_p1.mp4

# The FreeCut workspace lives outside the repo (docs/EDITING.md). These rules
# are a guard in case the app is ever re-pointed at a project folder again.
projects/*/.freecut-workspace.json
projects/*/media/
projects/*/projects/
projects/*/index.json

# LibreOffice lock files, left behind while a .csv is open
.~lock.*#

# Finder metadata, created by simply opening a folder on macOS.
.DS_Store

# Reel exports dropped at the projects/ root rather than inside a project, where
# none of the rules above can see them. A 64 MB copy of out/reel.mp4 sat here
# untracked and one `git add .` from the history.
projects/*.mp4

# Claude Code worktrees, created per-task under the repo and removed with
# `git worktree remove`. Never part of the tree they branch from.
.claude/worktrees/
